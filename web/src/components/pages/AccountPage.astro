---
import Base from "../../layouts/Base.astro";
import { useT, localizePath, type Lang } from "../../i18n";
import { getCatalog } from "../../lib/catalog";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useT(lang);
const seo = t("seo.account");
const catalog = await getCatalog(lang);

const cfg = {
  lang,
  waNumber: catalog.settings.waNumber,
  s: { ...t("account"), cow: t("common.cow"), buffalo: t("common.buffalo") },
};
---

<!-- Phone-OTP accounts, order history and self-reported billing, backed by
     the same Postgres database as the order form (web/src/pages/api/account/*). -->
<Base lang={lang} path="/account" title={seo.title} description={seo.description} settings={catalog.settings}>
  <section class="wrap narrow">
    <p class="eyebrow">{t("nav.account")}</p>
    <h1>{t("account.title")}</h1>

    <div id="acctRoot" style="margin-top:20px"></div>
  </section>

  <script type="application/json" id="account-cfg" set:html={JSON.stringify(cfg)}></script>
</Base>

<style>
  .acct-card h2 { margin:0 0 6px; font-size:1.15rem; }
  .acct-body { color:var(--muted); font-size:13.5px; margin:0 0 14px; }
  .acct-error { color:var(--danger); font-size:13px; font-weight:600; margin:0 0 10px; }
  .acct-devhint { font-size:12.5px; color:var(--gold); font-weight:700; margin:0 0 10px; }
  .acct-form { display:flex; gap:10px; }
  .acct-form input {
    flex:1; font:inherit; color:var(--ink); background:var(--cream);
    border:1.5px solid var(--line); border-radius:12px; padding:11px 13px;
  }
  .acct-form input:focus { outline:none; border-color:var(--leaf); box-shadow:0 0 0 3px rgba(78,154,84,.22); }
  .acct-card + .acct-card, .acct-loggedin .acct-card { margin-top:16px; }
  .acct-loggedin { display:flex; flex-direction:column; }
  .acct-logout { align-self:flex-end; margin-bottom:12px; }
  .acct-loading { color:var(--muted); font-size:13.5px; }
  .acct-row { display:flex; justify-content:space-between; align-items:center; gap:10px; border-top:1px solid var(--line); padding:11px 0; }
  .acct-row:first-of-type { border-top:none; padding-top:0; }
  .acct-row-main { font-size:13.5px; }
  .acct-row-sub { display:block; font-size:11.5px; color:var(--muted); margin-top:1px; }
  .acct-paid { color:var(--leaf); font-weight:700; font-size:12.5px; }
  .acct-paybtn { flex:none; padding:8px 12px; font-size:12.5px; }
</style>

<script>
  import { initAccountPage } from "../../lib/account-client";
  const cfgEl = document.getElementById("account-cfg");
  const root = document.getElementById("acctRoot");
  if (cfgEl && root) {
    const cfg = JSON.parse(cfgEl.textContent || "{}");
    initAccountPage(root, cfg);
  }
</script>
