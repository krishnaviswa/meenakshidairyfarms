---
import { useT, localizePath, NAV, type Lang } from "../i18n";
import { displayPhone, type SiteSettings } from "../lib/catalog";

interface Props { lang: Lang; settings: SiteSettings; }
const { lang, settings } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
const waHref = "https://wa.me/" + settings.waNumber;
const phoneLabel = displayPhone(settings.waNumber);
---

<footer class="site-footer">
  <div class="wrap fbar">
    <div>
      <div class="fname">{t("common.brand")}</div>
      <div class="tag">{t("common.tagline")}</div>
    </div>
    <nav aria-label={t("nav.menu")}>
      {NAV.map((item) => (
        <a href={localizePath(item.path, lang)}>{t(`nav.${item.key}`)}</a>
      ))}
    </nav>
    <p class="contact">
      <span>{t("common.callWhatsApp")}</span>
      <a href={waHref} rel="nofollow noopener">{phoneLabel}</a>
      {settings.contactEmail && (
        <>
          · <a href={"mailto:" + settings.contactEmail}>{settings.contactEmail}</a>
        </>
      )}
    </p>
    <p class="note">{t("common.footerNote")}</p>
    <p class="tag">© {year} {t("common.brand")}</p>
  </div>
</footer>
