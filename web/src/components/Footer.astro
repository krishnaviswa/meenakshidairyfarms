---
import { useT, localizePath, NAV, type Lang } from "../i18n";
import { type SiteSettings } from "../lib/catalog";

interface Props { lang: Lang; settings: SiteSettings; }
const { lang, settings } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
const waHref = "https://wa.me/" + settings.waNumber;
---

<footer class="site-footer">
  <div class="wrap fbar">
    <div>
      <div class="fname">{t("common.brand")}</div>
      <div class="tag">{t("common.tagline")}</div>
    </div>
    <nav aria-label={t("nav.menu")}>
      {NAV.map((item) => (
        <a href={localizePath(item.path, lang)}>{t(`nav.${item.key}`)}</a>
      ))}
    </nav>
    <p class="contact">
      <a href={waHref} rel="nofollow noopener" class="wa-link">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="16" height="16"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.14c-.24.68-1.42 1.31-1.95 1.36-.5.05-1.13.07-1.83-.11-.42-.13-.96-.31-1.66-.61-2.92-1.26-4.83-4.2-4.98-4.4-.15-.2-1.19-1.58-1.19-3.02s.76-2.14 1.03-2.44c.27-.29.58-.37.78-.37l.56.01c.18.01.42-.07.66.5.24.59.82 2.03.89 2.18.07.15.12.32.02.51-.09.2-.14.32-.28.49-.14.17-.3.38-.42.51-.14.14-.29.29-.12.57.17.28.75 1.24 1.61 2 1.11.99 2.05 1.29 2.34 1.44.29.14.46.12.63-.07.17-.2.72-.84.91-1.12.19-.29.39-.24.66-.14.27.09 1.7.8 1.99.95.29.14.48.21.55.33.07.12.07.68-.17 1.36Z"/></svg>
        <span>{t("common.callWhatsApp")}</span>
      </a>
    </p>
    <p class="note">{t("common.footerNote")}</p>
    <p class="tag">© {year} {t("common.brand")}</p>
  </div>
</footer>
