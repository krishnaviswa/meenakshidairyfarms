---
/* Illustrated hero banner — sky, pasture, a Sahiwal cow and a Murrah buffalo.
 * Original SVG art (not stock photography). Uses the sky/pasture CSS
 * tokens from global.css so it reads correctly in light and dark.
 * Swap-in point for real farm photography later: replace this component's
 * markup, keep the same <HeroScene /> usage site in HomePage.astro.
 */
---

<svg class="hero-scene" viewBox="0 0 1200 420" preserveAspectRatio="xMidYMax slice" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustration of a Sahiwal cow and Murrah buffalo grazing under an open sky">
  <defs>
    <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="var(--sky-top)" />
      <stop offset="1" stop-color="var(--sky-bottom)" />
    </linearGradient>
  </defs>

  <rect x="0" y="0" width="1200" height="420" fill="url(#skyGrad)" />

  <circle cx="990" cy="95" r="64" fill="var(--gold)" opacity="0.28" />

  <ellipse cx="200" cy="120" rx="90" ry="22" fill="#ffffff" opacity="0.3" />
  <ellipse cx="260" cy="105" rx="60" ry="16" fill="#ffffff" opacity="0.25" />
  <ellipse cx="620" cy="80" rx="70" ry="17" fill="#ffffff" opacity="0.22" />

  <path d="M0,270 C160,225 300,255 460,235 C640,212 800,250 1000,220 C1080,208 1150,222 1200,232 L1200,420 L0,420 Z" fill="var(--pasture-far)" />

  <g opacity="0.9">
    <rect x="95" y="205" width="10" height="56" rx="4" fill="#5b4632" />
    <circle cx="100" cy="196" r="34" fill="var(--leaf)" />
    <circle cx="78" cy="212" r="24" fill="var(--leaf)" />
    <circle cx="124" cy="210" r="26" fill="var(--leaf)" />
  </g>
  <g opacity="0.85">
    <rect x="1108" y="222" width="8" height="44" rx="3" fill="#5b4632" />
    <circle cx="1112" cy="214" r="26" fill="var(--leaf-bright)" />
  </g>

  <path d="M0,320 C200,275 380,315 560,292 C760,266 960,300 1200,278 L1200,420 L0,420 Z" fill="var(--pasture)" />

  <!-- Murrah buffalo (left) -->
  <g transform="translate(255,255)">
    <ellipse cx="0" cy="65" rx="78" ry="20" fill="#000000" opacity="0.12" />
    <rect x="-58" y="18" width="14" height="46" rx="6" fill="#1c1c1c" />
    <rect x="-24" y="22" width="14" height="46" rx="6" fill="#1c1c1c" />
    <rect x="16" y="22" width="14" height="46" rx="6" fill="#1c1c1c" />
    <rect x="50" y="18" width="14" height="46" rx="6" fill="#1c1c1c" />
    <ellipse cx="0" cy="6" rx="82" ry="42" fill="#1c1c1c" />
    <path d="M-70,-6 C-92,-10 -100,4 -88,16 C-80,4 -74,-2 -70,-6Z" fill="#1c1c1c" />
    <g transform="translate(-84,-32)">
      <circle cx="0" cy="0" r="26" fill="#1c1c1c" />
      <path d="M-18,-16 C-34,-30 -36,-46 -24,-54 C-26,-40 -20,-28 -10,-18Z" fill="#161616" />
      <path d="M14,-16 C30,-30 32,-46 20,-54 C22,-40 16,-28 6,-18Z" fill="#161616" />
      <ellipse cx="-9" cy="2" rx="3.4" ry="4.2" fill="#f4ede0" />
      <ellipse cx="7" cy="2" rx="3.4" ry="4.2" fill="#f4ede0" />
      <path d="M-6,15 Q0,20 6,15" stroke="#f4ede0" stroke-width="2" fill="none" stroke-linecap="round" />
    </g>
  </g>

  <!-- Sahiwal cow (right) -->
  <g transform="translate(760,262)">
    <ellipse cx="0" cy="60" rx="72" ry="18" fill="#000000" opacity="0.1" />
    <rect x="-52" y="16" width="13" height="42" rx="6" fill="#a9583a" />
    <rect x="-20" y="20" width="13" height="42" rx="6" fill="#a9583a" />
    <rect x="16" y="20" width="13" height="42" rx="6" fill="#a9583a" />
    <rect x="46" y="16" width="13" height="42" rx="6" fill="#a9583a" />
    <ellipse cx="0" cy="4" rx="74" ry="38" fill="#bd6a45" />
    <ellipse cx="-20" cy="-8" rx="18" ry="12" fill="#f1e6d8" opacity="0.55" />
    <ellipse cx="26" cy="12" rx="22" ry="14" fill="#f1e6d8" opacity="0.5" />
    <path d="M60,10 Q86,26 78,48 Q70,36 58,28Z" fill="#a9583a" />
    <g transform="translate(-70,-26)">
      <circle cx="0" cy="0" r="23" fill="#bd6a45" />
      <path d="M-16,-20 C-8,-30 2,-30 6,-22" stroke="#8a4a2c" stroke-width="4" fill="none" stroke-linecap="round" />
      <path d="M10,-20 C18,-30 26,-26 26,-18" stroke="#8a4a2c" stroke-width="4" fill="none" stroke-linecap="round" />
      <path d="M-24,-4 C-34,-2 -36,10 -28,16 C-26,6 -24,0 -24,-4Z" fill="#bd6a45" />
      <ellipse cx="-8" cy="2" rx="3" ry="3.6" fill="#2a2a22" />
      <ellipse cx="7" cy="2" rx="3" ry="3.6" fill="#2a2a22" />
      <path d="M-5,14 Q0,18 5,14" stroke="#5c3320" stroke-width="2" fill="none" stroke-linecap="round" />
    </g>
  </g>
</svg>
