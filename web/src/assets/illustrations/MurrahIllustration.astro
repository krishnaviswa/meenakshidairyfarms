---
/* Illustrated Murrah buffalo scene for the Our Farm page. Original SVG art,
 * theme-aware via the sky/pasture CSS tokens. Swap-in point for a real
 * photo later — same <MurrahIllustration /> usage site in OurFarmPage.astro.
 */
---

<svg class="breed-illustration" viewBox="0 0 500 340" preserveAspectRatio="xMidYMax slice" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustration of a Murrah buffalo">
  <defs>
    <linearGradient id="skyGradMurrah" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="var(--sky-top)" />
      <stop offset="1" stop-color="var(--sky-bottom)" />
    </linearGradient>
  </defs>
  <rect x="0" y="0" width="500" height="340" fill="url(#skyGradMurrah)" />
  <ellipse cx="90" cy="65" rx="38" ry="38" fill="var(--gold)" opacity="0.26" />
  <ellipse cx="380" cy="85" rx="55" ry="14" fill="#ffffff" opacity="0.28" />
  <path d="M0,190 C120,210 240,180 360,206 C420,218 470,200 500,208 L500,340 L0,340 Z" fill="var(--pasture-far)" />
  <path d="M0,236 C140,258 270,228 390,250 C440,260 470,246 500,252 L500,340 L0,340 Z" fill="var(--pasture)" />

  <g transform="translate(250,180) scale(1.65)">
    <ellipse cx="0" cy="74" rx="84" ry="19" fill="#000000" opacity="0.14" />
    <rect x="-62" y="20" width="15" height="50" rx="7" fill="#1c1c1c" />
    <rect x="-25" y="24" width="15" height="50" rx="7" fill="#1c1c1c" />
    <rect x="18" y="24" width="15" height="50" rx="7" fill="#1c1c1c" />
    <rect x="54" y="20" width="15" height="50" rx="7" fill="#1c1c1c" />
    <ellipse cx="0" cy="6" rx="88" ry="44" fill="#1c1c1c" />
    <path d="M-74,-8 C-98,-12 -106,4 -92,18 C-84,4 -78,-2 -74,-8Z" fill="#1c1c1c" />
    <g transform="translate(-90,-34)">
      <circle cx="0" cy="0" r="28" fill="#1c1c1c" />
      <path d="M-19,-17 C-37,-32 -39,-50 -25,-58 C-28,-43 -21,-30 -10,-19Z" fill="#141414" />
      <path d="M15,-17 C33,-32 35,-50 21,-58 C24,-43 17,-30 6,-19Z" fill="#141414" />
      <ellipse cx="-10" cy="2" rx="3.6" ry="4.4" fill="#f4ede0" />
      <ellipse cx="8" cy="2" rx="3.6" ry="4.4" fill="#f4ede0" />
      <path d="M-6,16 Q0,21 6,16" stroke="#f4ede0" stroke-width="2.2" fill="none" stroke-linecap="round" />
    </g>
  </g>
</svg>
