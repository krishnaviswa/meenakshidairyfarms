# Copy to .env in this folder.

# Local Docker Postgres (see docker-compose.yml at the repo root).
# Host 5433 — 5432 is often already taken on Windows.
DATABASE_URL=postgres://meenakshi:meenakshi_local@127.0.0.1:5433/meenakshi

# Canonical URLs + sitemap.
SITE_URL=http://localhost:4321

# Phone-OTP login. Any long random string works locally.
JWT_SECRET=change-me

# When true, verify-otp accepts the fixed code 000000 for any phone number,
# and request-otp echoes it back as `devCode`. No SMS is ever sent either way
# (there is no SMS provider wired up yet) — this only controls whether the
# code is a fixed dev value or a real generated one. Leave unset/false for
# anything resembling production.
OTP_DEV_MODE=true
